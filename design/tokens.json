{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "version": "1.1.1",
  "primitive": {
    "color": {
      "navy": {"$value": "#10233f", "$type": "color"},
      "blue": {"$value": "#2f6fed", "$type": "color"},
      "white": {"$value": "#ffffff", "$type": "color"},
      "gray-100": {"$value": "#f4f7fb", "$type": "color"},
      "gray-700": {"$value": "#334155", "$type": "color"},
      "green": {"$value": "#087f5b", "$type": "color"},
      "red": {"$value": "#b42318", "$type": "color"}
    },
    "space": {
      "1": {"$value": "4px", "$type": "dimension"},
      "2": {"$value": "8px", "$type": "dimension"},
      "3": {"$value": "12px", "$type": "dimension"},
      "4": {"$value": "16px", "$type": "dimension"},
      "6": {"$value": "24px", "$type": "dimension"},
      "8": {"$value": "32px", "$type": "dimension"}
    },
    "radius": {
      "sm": {"$value": "6px", "$type": "dimension"},
      "md": {"$value": "10px", "$type": "dimension"},
      "lg": {"$value": "16px", "$type": "dimension"}
    },
    "font": {
      "sans": {"$value": "Inter, system-ui, sans-serif", "$type": "fontFamily"},
      "body-size": {"$value": "16px", "$type": "dimension"}
    }
  },
  "semantic": {
    "background": {"canvas": {"$value": "{primitive.color.gray-100}"}, "surface": {"$value": "{primitive.color.white}"}},
    "text": {"primary": {"$value": "{primitive.color.navy}"}, "muted": {"$value": "{primitive.color.gray-700}"}},
    "border": {"default": {"$value": "#d8e0eb"}},
    "status": {"success": {"$value": "{primitive.color.green}"}, "danger": {"$value": "{primitive.color.red}"}},
    "focus": {"ring": {"$value": "{primitive.color.blue}"}}
  },
  "component": {
    "button": {"background": {"$value": "{primitive.color.blue}"}, "radius": {"$value": "{primitive.radius.sm}"}},
    "sidebar": {"background": {"$value": "{primitive.color.navy}"}},
    "card": {"background": {"$value": "{semantic.background.surface}"}, "radius": {"$value": "{primitive.radius.md}"}},
    "badge": {"success": {"$value": "{semantic.status.success}"}},
    "dialog": {"radius": {"$value": "{primitive.radius.lg}"}}
  }
}
