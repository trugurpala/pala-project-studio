        "scripts/pala_product.py",
        "scripts/pala_product_e2e.py",
        "scripts/pala_product_planner.py",
        "scripts/pala_quality.py",
        "scripts/pala_quality_discovery.py",
        "scripts/pala_store.py",
        "scripts/pala_task_packet.py",
        "scripts/test_pala_hardening.py",
        "scripts/test_pala_product.py",
        "scripts/test_pala_quality.py",
        "scripts/test_pala_tools.py",
        "--ignore",
        "E501"
      ],
      "tiers": [
        "narrow",
        "ticket",
        "milestone",
        "release"
      ]
    },
    {
      "id": "mypy-critical",
      "kind": "typecheck",
      "argv": [
        "uv",
        "run",
        "--group",
        "dev",
        "mypy"
      ],
      "tiers": [
        "milestone",
        "release"
      ]
    },
