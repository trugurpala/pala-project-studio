      "kind": "integration",
      "argv": [
        "uv",
        "run",
        "--group",
        "dev",
        "coverage",
        "report",
        "--data-file=artifacts/quality/.coverage-current",
        "--fail-under=75"
      ],
      "tiers": [
        "milestone",
        "release"
      ]
    },
    {
