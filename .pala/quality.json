{
  "schema_version": 1,
  "checks": [
    {
      "id": "product-contracts",
      "kind": "unit",
      "argv": [
        "py",
        "-3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_pala_product*.py"
      ],
      "tiers": [
        "narrow",
        "ticket",
        "milestone",
        "release"
      ]
    },
    {
      "id": "unittest",
      "kind": "unit",
      "argv": [
        "py",
        "-3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts",
        "-p",
        "test_*.py"
      ],
      "tiers": [
        "ticket",
        "milestone",
        "release"
      ]
    },
    {
