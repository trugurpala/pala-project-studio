{
  "description": "Durable project-state reminders for projects registered by Pala Project Finisher.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/pala_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\pala_hook.py\"",
            "timeout": 10,
            "statusMessage": "Proje durumu yükleniyor",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/pala_rtk_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\pala_rtk_hook.py\"",
            "timeout": 5,
            "statusMessage": "Güvenli komut optimizasyonu kontrol ediliyor"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/pala_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\pala_hook.py\"",
            "timeout": 10,
            "statusMessage": "Çalışma bağlamı kaydediliyor"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/pala_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\pala_hook.py\"",
            "timeout": 10,
            "statusMessage": "Oturum sahipliği kapatılıyor"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/scripts/pala_hook.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\scripts\\pala_hook.py\"",
            "timeout": 10,
            "statusMessage": "İlerleme kaydı kontrol ediliyor"
          }
        ]
      }
    ]
  }
}
